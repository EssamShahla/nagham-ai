# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/nagham_ai


# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY


# ============================================
# Email / OTP
# ============================================
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD


# ============================================
# AI / LLM provider
# ============================================
# LLM_PROVIDER: "ollama" (default, local) or "openai_compatible"
# (any OpenAI-compatible hosted API, e.g. Groq, OpenRouter).
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama. Must already be pulled locally
# (ollama pull qwen2.5:3b).
OLLAMA_MODEL=qwen2.5:3b

# Used when LLM_PROVIDER=openai_compatible.
# Example (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET


# ============================================
# Application
# ============================================
FRONTEND_URL=http://localhost:3000

# Comma-separated list of extra allowed CORS origins (production
# frontend URL). http://localhost:3000 and http://127.0.0.1:3000
# are always allowed for local development.
CORS_ALLOWED_ORIGINS=